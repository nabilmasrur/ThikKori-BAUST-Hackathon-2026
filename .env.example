# ── ThikKori environment ─────────────────────────────────────────────
# Copy to .env.local (git-ignored) and fill in.
#
# BACKEND SELECTION
# Leave the two Supabase values empty and the app runs on the built-in
# local backend (IndexedDB-free localStorage store + BroadcastChannel
# realtime). Fill them in and the Supabase adapter takes over automatically.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ADMIN PANEL
# There is no public admin registration. These are the only admin credentials.
VITE_ADMIN_EMAIL=admin@thikkori.com.bd
VITE_ADMIN_PASSWORD=thikkori-admin-2026

# PLATFORM
# Commission taken on every invoice, as a decimal fraction.
VITE_PLATFORM_FEE_RATE=0.05
# Public origin used when encoding invoice QR codes.
VITE_PUBLIC_ORIGIN=
